# Application
APP_NAME=Waste Volume Estimation API
APP_VERSION=1.0.0
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_PREFIX=/api/v1

# Security (generate with: python -c "import secrets; print(f'wst_{secrets.token_urlsafe(32)}')")
SECRET_KEY=change-me-in-production-min-32-chars
# Use the same stable SECRET_KEY for API and all workers (source/ownership HMAC).
API_KEY_HEADER=X-API-Key
VALID_API_KEYS=
CORS_ORIGINS=

# Database
DATABASE_URL=postgresql+asyncpg://waste:waste@localhost:5432/waste_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=300

# File Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/waste-api
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT_URL=

# Models
MODELS_DIR=/models
DEFAULT_SEG_MODEL=yolo11s-seg.pt
DEFAULT_DEPTH_MODEL=yolo26n-depth.pt
DEPTH_SCALE_TIMEOUT_SEC=120
# Fit gates are heuristics, not physical accuracy certification.
DEPTH_SCALE_MAX_MEAN_RESIDUAL_M=0.25
DEPTH_SCALE_MAX_RESIDUAL_M=0.5
DEPTH_SCALE_MAX_RELATIVE_RESIDUAL=0.1

# Processing defaults
DEFAULT_SEG_CONF=0.25
DEFAULT_SEG_IOU=0.7
DEFAULT_SEG_IMGSZ=1280
DEFAULT_DEPTH_IMGSZ=768
DEFAULT_VOLUME_CELL_M=0.05
DEFAULT_VOLUME_MIN_PTS_PER_CELL=2
DEFAULT_BEV_PPM=200
DEFAULT_BEV_MARGIN_M=1.0
DEFAULT_DEPTH_CLIP_MIN_M=0.1
DEFAULT_DEPTH_CLIP_MAX_M=50.0

# Calibration defaults
DEFAULT_CHESSBOARD_COLS=9
DEFAULT_CHESSBOARD_ROWS=6
DEFAULT_SQUARE_M=0.025
MIN_CALIB_IMAGES=10
RECOMMENDED_CALIB_IMAGES=20

# MediaMTX (CCTV Streaming)
MEDIAMTX_HOST=localhost
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_ENABLED=false
MEDIAMTX_API_USER=sivera_api
# Required by Compose; generate two different secrets, never commit them.
MEDIAMTX_API_PASSWORD=
MEDIAMTX_READ_USER=sivera_reader
MEDIAMTX_READ_PASSWORD=
# Exact comma-separated camera hostnames/IPs; empty denies all RTSP sources.
MEDIAMTX_ALLOWED_RTSP_HOSTS=
MEDIAMTX_RECONCILE_INTERVAL=30
MEDIAMTX_SESSION_TTL_SEC=86400
MEDIAMTX_MAX_SDP_BYTES=65536
# LAN IP or public DNS/IP reachable by the dashboard, not the Docker hostname.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
# Stream settings
STREAM_TIMEOUT=10
STREAM_RETRY_ATTEMPTS=3
STREAM_CAPTURE_TIMEOUT=15
# Original-resolution frames; API and capture/calibration/prediction workers share storage.
CAPTURE_MAX_FRAME_BYTES=10485760
CAPTURE_MAX_PIXELS=16777216
CAPTURE_MAX_CONSECUTIVE_FAILURES=3
CAPTURE_HEARTBEAT_TIMEOUT_SEC=45
CAPTURE_QUEUE_TIMEOUT_SEC=120
CAPTURE_RECONCILE_INTERVAL_SEC=5
# Laplacian variance inside the detected board; tune against camera fixtures.
CALIB_CAPTURE_MIN_SHARPNESS=80
# Includes legacy frame assessment and calibration computation, queue time excluded.
CALIB_COMPUTE_TIMEOUT_SEC=300
